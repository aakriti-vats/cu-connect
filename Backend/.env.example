# CU-Connect backend environment. Copy to `.env` for local dev and set real
# values in your host's dashboard (Render/Railway) for production.

# App
NODE_ENV=development
PORT=4000

# Auth — REQUIRED in production. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cu-connect-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Database — MongoDB Atlas connection string in production.
# Local:  mongodb://127.0.0.1:27017/cu-connect
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cu-connect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cu-connect

# CORS — comma-separated list of allowed frontend origins (the Vercel URLs).
# Leave empty for same-origin local dev.
# e.g. CORS_ORIGINS=https://cu-connect.vercel.app,https://cu-connect-git-main.vercel.app
CORS_ORIGINS=

# Code IDE — the local runner is UNSANDBOXED. Keep off in production until a
# real sandbox (Judge0/Docker) is wired up. Defaults: on in dev, off in prod.
IDE_ENABLED=
